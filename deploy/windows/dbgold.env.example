APP_ENV=production
LISTEN_HOST=0.0.0.0
PORT=18089
STATIC_DIR="C:/Program Files/dbgold/web"
TRUSTED_PROXIES=

SQLITE_PATH=C:/ProgramData/dbgold/data/dbgold.db
UPLOAD_DIR=C:/ProgramData/dbgold/uploads
LOG_DIR=C:/ProgramData/dbgold/logs

JWT_SECRET=__GENERATED_BY_INSTALLER__
JWT_EXPIRE_HOURS=240
ADMIN_USER=admin
ADMIN_PASS=__GENERATED_BY_INSTALLER__

LOG_LEVEL=info
LOG_MAX_FILES=7
LOG_MAX_TOTAL_MB=2048
MAX_UPLOAD_BYTES=53687091200
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=1000
QUERY_AUDIT_RETENTION_DAYS=90

# 仅神通连接需要目标机 Java 8+，推荐 Java 17。请确保 LocalService 可读取并执行。
# 例如 OSCAR_JAVA_BIN="C:/Program Files/Java/jdk-17/bin/java.exe"
# 留空时依次查找服务环境的 JAVA_HOME 和 PATH。JDBC 驱动默认使用安装目录中的 lib。
OSCAR_JAVA_BIN=
OSCAR_JDBC_JAR=
OSCAR_LOGIN_TIMEOUT_MS=15000
OSCAR_SOCKET_TIMEOUT_MS=0
OSCAR_BRIDGE_XMX_MB=512
